# Server Port
PORT=5000

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=crm_db
PGUSER=postgres
PGPASSWORD=postgres

# Alternatively, you can use a single connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_db

# MCP ORDS Gateway Configuration (Optional - for data sync)
MCP_TOKEN_URL=https://your-auth-server/protocol/openid-connect/token
MCP_URL=https://your-mcp-server/mcp
MCP_CLIENT_ID=your_client_id
MCP_CLIENT_SECRET=your_client_secret
MCP_USERNAME=your_username
MCP_PASSWORD=your_password
MCP_DATABASE=mcp_cms_read
